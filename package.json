{
  "name": "agape-sovereign",
  "version": "1.0.0",
  "description": "Agape Sovereign Application and Firebase Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:all": "vite build && npm run build --prefix functions",
    "build:frontend": "vite build",
    "build:functions": "npm run build --prefix functions",
    "deploy": "firebase deploy",
    "lint": "npm run lint --prefix functions",
    "typecheck": "tsc --noEmit && npm run typecheck --if-present --prefix functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@google/genai": "latest",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.9",
    "@tailwindcss/vite": "^4.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "cookie-parser": "^1.4.7",
    "esbuild": "^0.25.0",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.0",
    "firebase": "^11.4.0",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.25.1",
    "framer-motion": "^12.4.7",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.1",
    "react-router-dom": "7.11.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^2.15.1",
    "remark-gfm": "^4.0.0",
