{
  "name": "architect-ai-agape-sovereign-enclave-2026",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev-frontend": "npm run dev --prefix frontend",
    "dev-backend": "npm run dev --prefix backend",
    "commit": "git add . && git commit -m \"chore: update dependencies\"",
    "dev": "concurrently \"npm run dev-frontend\" \"npm run dev-backend\"",
    "build": "npm run build --prefix frontend",
    "deploy": "npm run build && firebase deploy"
  },
  "devDependencies": {
    "concurrently": "latest"
  },
  "dependencies": {
    "audius": "^1.1.1",
    "firebase": "^15.33.0",
    "openclaw": "^2026.10.3",
    "protobufjs": "^8.8.1"
  },
  "allowScripts": {
    "@google/genai@2.24.0": true,
    "@firebase/util@1.15.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "koffi@3.3.1": true,
    "protobufjs@7.6.6": true,
    "protobufjs@6.11.6": true,
    "fsevents@1.2.13": true,
    "openclaw@2026.10.4": true,
    "nodemon@1.14.10": true
  }
}
