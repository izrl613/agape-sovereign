{
  "name": "architect-ai-agape-sovereign-enclave-2026",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev-frontend": "npm run dev --prefix frontend",
    "dev-backend": "npm run dev --prefix backend",
    "commit": "git add . && git commit -m \"chore: update dependencies\"",
    "dev": "concurrently \"npm run dev-frontend\" \"npm run dev-backend\"",
    "lint": "npm run lint --prefix frontend",
    "check": "npm run check --prefix frontend",
    "typecheck": "node scripts/check-frontend-quality.mjs",
    "build": "npm run build --prefix frontend",
    "postdeploy:cdn": "node scripts/purge-cdn-cache.mjs",
    "deploy": "firebase deploy",
    "build:frontend": "npm run build --prefix frontend",
    "build:functions": "npm run build --prefix functions"
  },
  "devDependencies": {
    "concurrently": "latest"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "protobufjs": "^8.8.1"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "koffi@3.3.1": true,
    "protobufjs@7.6.6": true,
    "protobufjs@6.11.6": true,
    "fsevents@1.2.13": true,
    "nodemon@1.14.10": true
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.4"
  }
}