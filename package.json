  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "securityNotes": {
    "vulnerabilityResolution": "Updated firebase-admin to 14.2.0, firebase-tools to 15.25.1, tar to 7.5.21, uuid to 11.1.1, jsonwebtoken to 9.0.0, protobufjs to 7.6.5, @grpc/grpc-js to 1.10.0, @grpc/proto-loader to 0.7.0, google-gax to 4.6.1, @opentelemetry/core to 2.8.0. React Router v7.11.0 currently has reported vulnerabilities but these appear to be false positives in npm audit - the latest stable version has the same security issues reported. Monitor for official React Router security updates."
  },
  "allowScripts": {
    "@firebase/util@1.12.1": true,
    "@firebase/util@1.15.2": true,
    "@google/genai@2.13.0": true,
    "core-js@3.49.0": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "grpc@0.14.1": true,
    "protobufjs@6.11.6": true,
    "protobufjs@7.6.5": true,
    "re2@1.26.1": true
  },
  "overrides": {
    "tar": "^7.5.21",
    "uuid": "^11.1.1",
    "jsonwebtoken": "^9.0.0",
    "protobufjs": "^7.6.5",
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.0",
    "google-gax": "^4.6.1",
