{
  "name": "architect-ai-agape-sovereign-enclave-2026",
  "private": true,
  "version": "2.6.0",
  "workspaces": [
    "frontend",
    "backend",
    "functions"
  ],
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "jspdf": "4.2.1"
  },
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev-frontend": "npm run dev --prefix frontend",
    "dev-backend": "npm run dev --prefix backend",
    "lint": "npm run lint --prefix frontend",
    "check": "npm run check --prefix frontend",
    "typecheck": "npx tsc --noEmit -p frontend/tsconfig.json && node scripts/check-frontend-quality.mjs",
    "build:frontend": "npm run build --prefix frontend && node scripts/sync-static-dist.mjs",
    "build:functions": "npm run build --prefix functions",
    "build:all": "npm run build:frontend && npm run build:functions",
    "build": "npm run build:frontend",
    "postdeploy:cdn": "node scripts/purge-cdn-cache.mjs",
    "deploy": "firebase deploy --project agape-sovereign"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2"
  }
}
