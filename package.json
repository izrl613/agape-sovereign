{
  "name": "agape-sovereign",
  "version": "1.0.0",
  "private": true,
  "description": "Agape Sovereign AI — Digital Identity Defense Enclave",
  "scripts": {
    "commit": "git add -A && git commit",
    "devcommit": "npm run lint && npm run commit",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:functions": "npm --prefix functions run build",
    "lint": "npm --prefix frontend run lint",
    "check": "npm --prefix frontend run check",
    "typecheck": "npm --prefix frontend run typecheck",
    "test": "npm --prefix functions test",
    "deploy": "firebase deploy",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:firestore": "firebase deploy --only firestore",
    "test:security": "vitest run --config vitest.security.config.mts"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/jspdf": "^1.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
