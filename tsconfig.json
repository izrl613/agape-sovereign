{
  "extends": "./frontend/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./frontend",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "frontend/index.tsx",
    "frontend/App.tsx",
    "frontend/firebase.ts",
    "frontend/theme.ts",
    "frontend/types.ts",
    "frontend/constants.ts",
    "frontend/config.ts",
    "frontend/vite-env.d.ts",
    "frontend/auth/**/*.ts",
    "frontend/context/**/*.tsx",
    "frontend/services/**/*.ts",
    "frontend/utils/**/*.ts",
    "frontend/components/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "frontend/dist",
    "functions",
    "backend",
    "src"
  ]
}
