{
  "hosting": {
    "site": "agape-sovereign",
    "predeploy": [
      "npm --prefix \"frontend\" run lint",
      "npm --prefix \"frontend\" run build"
    ],
    "postdeploy": [
      "node scripts/purge-cdn-cache.mjs"
    ],
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://apis.google.com https://www.gstatic.com; connect-src 'self' https: wss://*.firebaseio.com; frame-src https://accounts.google.com https://sovereign.nyc https://agape-sovereign.firebaseapp.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; object-src 'none'; base-uri 'self'"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/auth/**",
        "function": {
          "functionId": "authApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/architect/**",
        "function": {
          "functionId": "architectApi",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "source": "functions"
    }
  ],
  "firestore": [
    {
      "database": "agape-sovereign",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ]
}