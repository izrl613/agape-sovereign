/**
 * Architect AI — Nano-Sized Client-Side MCP Worker
 *
 * This worker implements the Model Context Protocol (MCP) directly in the browser.
 * It ensures that all PII is stripped and tokenized before any AI request is made,
 * maintaining the Zero-Knowledge boundary.
 */

import { hashSHA256 } from '../lib/encryption';

interface MCPRequest {
  method: string;
  params: any;
  id: string;
}

interface MCPResponse {
  id: string;
  result?: any;
  error?: string;
}

// PII Stripping Logic: Ensures no raw user data ever leaves the worker
function stripPII(data: any): any {
  if (typeof data !== 'object' || data === null) return data;

  const stripped = Array.isArray(data) ? [] : {};
  for (const [key, value] of Object.entries(data)) {
    if (typeof value === 'string' && (key.toLowerCase().includes('email') || key.toLowerCase().includes('phone') || key.toLowerCase().includes('name'))) {
      // Replace PII with a cryptographic hash for structural anonymity
      stripped[key] = `hash:${hashSHA256(value).then(h => h.slice(0, 8))}`;
    } else if (typeof value === 'object') {
      stripped[key] = stripPII(value);
    } else {
      stripped[key] = value;
    }
  }
  return stripped;
}

self.onmessage = async (event: MessageEvent) => {
  const { request } = event.data as { request: MCPRequest };
  const { method, params, id } = request;

  try {
    switch (method) {
      case 'analyze_identity_vector': {
        // 1. Strip PII locally
        const anonymousParams = stripPII(params);

        // 2. Route to the MCP Client (which then talks to the local/cloud AI)
        // In a real Nano-MCP, we would invoke a local SLM via WebGPU here.
        // For this implementation, we proxy back to the main thread to use the MCPClient.
        self.postMessage({
          type: 'PROXY_REQUEST',
          id,
          method,
          params: anonymousParams,
        });
        break;
      }
      case 'ask': {
        const anonymousParams = stripPII(params);
        self.postMessage({
          type: 'PROXY_REQUEST',
          id,
          method,
          params: anonymousParams,
        });
        break;
      }
      default:
        self.postMessage({
          id,
          error: `Method ${method} not supported by Nano-MCP Worker.`,
        });
    }
  } catch (error: any) {
    self.postMessage({
      id,
      error: error.message,
    });
  }
};
