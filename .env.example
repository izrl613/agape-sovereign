# ── Agape Sovereign Enclave — Environment Variables ──────────────────────────

# Firebase (Client-side — prefix with VITE_ for Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google OAuth 2.0 Web Client ID (OAuth client, NOT the API key) — optional.
# Used ONLY as a fallback Drive-token path if the access token captured at
# Firebase Google sign-in has expired. Format:
#   <project-number>-<hash>.apps.googleusercontent.com
# Primary path needs nothing here: the drive.file scope is requested on the
# Firebase GoogleAuthProvider, so sign-in consent already federates Drive.
VITE_GOOGLE_CLIENT_ID=


# Google Cloud (Server-side)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# WebAuthn / Passkey Configuration
# ─────────────────────────────────────────────────────────────────────────────
# WEBAUTHN_RP_ID must match the domain the PWA is served from.
# - Local dev:    localhost
# - Production:   sovereign.nyc  (NO https://, NO port, NO path)
#
# WEBAUTHN_ORIGIN must be the full origin (scheme + host + optional port):
# - Local dev:    http://localhost:5000
# - Production:   https://sovereign.nyc
#
# To force hardware-key-only (YubiKey, etc.) set WEBAUTHN_RP_ID + WEBAUTHN_ORIGIN
# and ensure generateRegistrationOptions uses authenticatorAttachment: 'cross-platform'
# ─────────────────────────────────────────────────────────────────────────────
WEBAUTHN_RP_NAME=Agape Sovereign
WEBAUTHN_RP_ID=sovereign.nyc
WEBAUTHN_ORIGIN=https://sovereign.nyc

# Server
PORT=5000
PROXY_HEADER=
COOKIE_SECRET=

# reCAPTCHA Enterprise (1M assessments/month free tier)
RECAPTCHA_SITE_KEY=
RECAPTCHA_ENABLED=false

# Demo Bypass Mode (set to true to show the demo guest button on the login page)
# Also activatable per-session via: /login?demo=true
VITE_DEMO_MODE=false
