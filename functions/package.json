{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/bigquery": "^9.6.1",
    "@google-cloud/error-reporting": "^4.0.0",
    "@simplewebauthn/server": "^13.3.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.1.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.4",
    "@types/jspdf": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.5.0",
    "typescript": "^6.0.0",
    "vitest": "^5.1.2"
  },
  "private": true,
  "overrides": {
    "jsrsasign": "^11.1.1"
  }
}