# ── Agape Sovereign Functions — Environment Variables ──────────────────────────

# Firebase Admin (auto-configured in Cloud Functions)
# GOOGLE_CLOUD_PROJECT=agape-sovereign
# FIREBASE_CONFIG={"projectId":"agape-sovereign",...}

# WebAuthn / Passkey Configuration
# ─────────────────────────────────────────────────────────────────────────────
# WEBAUTHN_RP_ID must match the domain the PWA is served from.
# - Local dev:    localhost
# - Production:   sovereign.nyc  (NO https://, NO port, NO path)
#
# WEBAUTHN_ORIGIN must be the full origin (scheme + host + optional port):
# - Local dev:    http://localhost:5000
# - Production:   https://sovereign.nyc
#
# To force hardware-key-only (YubiKey, etc.) set WEBAUTHN_RP_ID + WEBAUTHN_ORIGIN
# and ensure generateRegistrationOptions uses authenticatorAttachment: 'cross-platform'
# ─────────────────────────────────────────────────────────────────────────────
WEBAUTHN_RP_NAME=Agape Sovereign
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5000
WEBAUTHN_EXTRA_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookie Secrets (set via Firebase Functions secrets: firebase functions:secrets:set)
# PASSKEY_COOKIE_SECRET=<base64-encoded-32-byte-secret>
# COOKIE_SECRET=<base64-encoded-32-byte-secret>

# reCAPTCHA Enterprise (MANDATORY for 100% Free-Tier GCP protection)
# Without App Check, bots can bypass client and exhaust the 15 RPM free-tier
# limit instantly, taking the platform offline. The free tier includes 1M
# assessments/month — sufficient for Architect AI's traffic at 15 RPM.
# Get keys from: https://cloud.google.com/recaptcha-enterprise
# .env MUST have RECATCHA_ENABLED=true or firebase deploy will fail with:
#   "CRITICAL: RECATCHA_ENABLED is not set to 'true'. Bot abuse will exhaust
#    the 15 RPM free-tier quota."
RECATCHA_ENABLED=true
RECAPTCHA_SITE_KEY=enter_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=enter_recaptcha_secret_key_here

# Node Environment
NODE_ENV=production

# BigQuery (optional - for analytics export)
BIGQUERY_DATASET=agape_sovereign_analytics
BIGQUERY_TABLE=events

# Feature Flags
FEATURE_DEMO_MODE=false
FEATURE_ANALYTICS_EXPORT=false