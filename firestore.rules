rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable global security primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email in ['idin@agape.nyc', 'agape@sovereign.nyc']
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // System-level capacity tracking (aggregate counters — no PII stored)
    match /system/{document} {
      allow read, write: if isSignedIn() && isValidId(document);
    }

    match /system/capacity {
      allow read: if isSignedIn();
      allow write: if isSignedIn() 
                   && request.resource.data.keys().hasOnly(['slots'])
                   && request.resource.data.slots is number
                   && request.resource.data.slots >= 0;
    }

    // Static identity vector definitions (read-only for authenticated users)
    match /identity_vectors/{vectorId} {
      allow read: if isSignedIn() && isValidId(vectorId);
      allow write: if isAdmin();
    }

    // Per-user vector statuses (scoped to authenticated user)
    match /user_vector_statuses/{statusId} {
      allow read, write: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (request.resource != null && request.resource.data.userId == request.auth.uid) ||
        statusId.matches('^' + request.auth.uid + '_.*')
      );
    }

    // Findings collection (scoped to owner)
    match /findings/{findingId} {
      allow read, write: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );
    }

    // Monitored emails (scoped to owner)
    match /monitored_emails/{emailId} {
      allow read, write: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );
    }

    // DIFF Scans (scoped to owner)
    match /diff_scans/{scanId} {
      allow read, write: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );
    }

    // Chat Sessions (scoped to owner)
    match /chat_sessions/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);
    }

    // Score History (scoped to owner)
    match /score_history/{historyId} {
      allow read, write: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );
    }

    // Security Audit Logs (append-only by owner, readable by owner or admin)
    match /audit_logs/{logId} {
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.userId == null
      );
      allow read: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      allow update, delete: if false; // Append-only audit trail
    }

    // Sovereign user accounts & private sandboxes
    match /users/{userId} {
      allow get, write: if (isOwner(userId) && isValidId(userId)) || isAdmin();
      allow list: if isAdmin();

      // Module Data & Parameters Subcollection
      match /module_data/{docId} {
        allow read, write: if isOwner(userId) && isValidId(docId);
      }

      // Identity Sandbox Partition Modules Subcollection
      match /modules/{moduleId} {
        allow read, write: if isOwner(userId) && isValidId(moduleId);
      }

      // Symmetrically ciphered password keychains
      match /passwords/{passwordId} {
        allow read, write: if isOwner(userId) && isValidId(passwordId);
      }

      // E2EE encrypted chats/messages logs
      match /messages/{messageId} {
        allow read, write: if isOwner(userId) && isValidId(messageId);
      }

      // Sovereign Secure Document Vault
      match /vault/{vaultId} {
        allow read, write: if isOwner(userId) && isValidId(vaultId);
      }

      // Intercepted trackers metrics log
      match /trackers/{trackerId} {
        allow read, write: if isOwner(userId) && isValidId(trackerId);
      }

      // Dynamic Security Audit Logs
      match /auditLogs/{logId} {
        allow read, write: if isOwner(userId) && isValidId(logId);
      }

      // WebAuthn passkey credentials (written by Admin SDK in Cloud Functions).
      match /passkeyCredentials/{credentialId} {
        allow read: if isOwner(userId) && isValidId(credentialId);
        allow write: if false; // Admin SDK only
      }
    }
  }
}
