rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'idin@agape.nyc',
          'agape@sovereign.nyc'
        ];
    }

    // Per-user enclave data: wrapped DEK + sealed receipts.
    // Client SDK only ever reads/writes under the caller's own uid.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Admin audit surface: read-only for admins; all writes go through
    // Cloud Functions (Admin SDK bypasses rules).
    match /admin/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Deny-by-default catch-all — zero-trust baseline.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
