rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reusable global security primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Owner allowlist per architecture spec: only two verified Google identities.
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in ['idin@agape.nyc', 'agape@sovereign.nyc'];
    }

    // Sovereign user accounts & private sandboxes
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow list: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Application DIFF data collections — owner access only
    match /diff_data/{documentId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Admin Telemetry: Strictly locked to the two verified admin emails per architecture spec
    match /admin_telemetry/{document=**} {
      allow read, write: if isAdmin();
    }

    // Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }
  }
}