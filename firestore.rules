rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── GLOBAL DEFAULT DENY-ALL ───────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── REUSABLE SECURITY PRIMITIVES ─────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // NOTE: isAppVerified() checks Firebase App Check (request.app != null).
    // App Check is currently NOT initialized on the client — so this returns
    // false in all environments. We therefore treat it as a "best-effort"
    // gate: writes still require it, but reads do NOT, so the app remains
    // functional until App Check is wired up.
    // When App Check is enabled, uncomment the stricter read rules below.
    function isAppVerified() {
      return request.app != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.admin == true;
    }

    // Relaxed ID validator: allows alphanumeric, underscore, hyphen, and @.
    // Firebase UIDs are alphanumeric only, but Firestore auto-IDs can include
    // other safe chars. The '@' is needed for email-keyed docs.
    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp
        && ts > request.time - duration.value(5, 'm')
        && ts <= request.time + duration.value(1, 'm');
    }

    function maxDocSize(bytes) {
      return request.resource.size() <= bytes;
    }

    function hasOnlyKeys(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    // ─── SYSTEM (capacity gate — specific paths only) ──────────────────────
    // Reads are allowed for all signed-in users (App Check not required for reads
    // since App Check is not yet initialized on the client).
    // Writes still require App Check when it becomes available.
    match /system/capacity {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && maxDocSize(2048)
        && request.resource.data.keys().hasAny(['slots', 'activeUsers', 'maxUsers', 'lastReservedAt'])
        && request.resource.data.keys().hasOnly([
          'slots', 'activeUsers', 'maxUsers',
          'lastReservedAt', 'lastReservedBy'
        ])
        && (!('slots' in request.resource.data) || (request.resource.data.slots is int && request.resource.data.slots >= 0))
        && (!('activeUsers' in request.resource.data) || (request.resource.data.activeUsers is int && request.resource.data.activeUsers >= 0))
        && (!('maxUsers' in request.resource.data) || (request.resource.data.maxUsers is int && request.resource.data.maxUsers > 0));
    }

    // Explicitly deny everything else under /system
    match /system/{document} {
      allow read, write: if false;
    }

    // ─── USERS / OWNER SANDBOX ─────────────────────────────────────────────
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) && isValidId(userId) && maxDocSize(16384);
      allow delete: if false;

      // ─── diff_scans (migrated from flat collection → subcollection) ────
      // Reads require only ownership (no App Check — empty collections must be
      // listable for new users before App Check is initialized).
      match /diff_scans/{scanId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(scanId)
          && maxDocSize(8192)
          && request.resource.data.userId == userId
          && request.resource.data.keys().hasOnly([
            'userId', 'module', 'finding', 'status',
            'timestamp', 'details', 'seal'
          ])
          && isValidTimestamp(request.resource.data.timestamp);
        allow update: if isOwner(userId)
          && isValidId(scanId)
          && maxDocSize(8192)
          && request.resource.data.userId == userId
          && request.resource.data.keys().hasOnly([
            'userId', 'module', 'finding', 'status',
            'timestamp', 'details', 'seal'
          ])
          && isValidTimestamp(request.resource.data.timestamp);
        allow delete: if false;
      }

      // ─── score_history ──────────────────────────────────────────────────
      match /score_history/{entryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(entryId)
          && maxDocSize(4096)
          && request.resource.data.userId == userId
          && request.resource.data.keys().hasOnly([
            'userId', 'score', 'tier', 'breakdown',
            'timestamp', 'seal', 'source'
          ])
          && isValidTimestamp(request.resource.data.timestamp);
        allow update: if isOwner(userId)
          && isValidId(entryId)
          && maxDocSize(4096)
          && request.resource.data.userId == userId
          && request.resource.data.keys().hasOnly([
            'userId', 'score', 'tier', 'breakdown',
            'timestamp', 'seal', 'source'
          ])
          && isValidTimestamp(request.resource.data.timestamp);
        allow delete: if false;
      }

      // ─── modules ────────────────────────────────────────────────────────
      // FIX: Removed isAppVerified() from reads — App Check not yet initialized.
      match /modules/{moduleId} {
        allow read: if isOwner(userId) && isValidId(moduleId);
        allow write: if isOwner(userId)
          && isValidId(moduleId)
          && maxDocSize(8192);
      }

      // ─── module_data ────────────────────────────────────────────────────
      match /module_data/{document} {
        allow read: if isOwner(userId) && isValidId(document);
        allow write: if isOwner(userId)
          && isValidId(document)
          && maxDocSize(8192);
      }

      // ─── passwords ──────────────────────────────────────────────────────
      match /passwords/{passwordId} {
        allow read: if isOwner(userId) && isValidId(passwordId);
        allow write: if isOwner(userId)
          && isValidId(passwordId)
          && maxDocSize(4096);
      }

      // ─── messages (E2EE logs) ───────────────────────────────────────────
      match /messages/{messageId} {
        allow read: if isOwner(userId) && isValidId(messageId);
        allow write: if isOwner(userId)
          && isValidId(messageId)
          && maxDocSize(4096);
      }

      // ─── vault ──────────────────────────────────────────────────────────
      match /vault/{vaultId} {
        allow read: if isOwner(userId) && isValidId(vaultId);
        allow write: if isOwner(userId)
          && isValidId(vaultId)
          && maxDocSize(4096);
      }

      // ─── trackers ───────────────────────────────────────────────────────
      match /trackers/{trackerId} {
        allow read: if isOwner(userId) && isValidId(trackerId);
        allow write: if isOwner(userId)
          && isValidId(trackerId)
          && maxDocSize(4096);
      }

      // ─── auditLogs (dynamic security audit logs) ────────────────────────
      match /auditLogs/{logId} {
        allow read: if isOwner(userId) && isValidId(logId);
        allow create: if isOwner(userId)
          && isValidId(logId)
          && maxDocSize(4096)
          && request.resource.data.keys().hasOnly([
            'type', 'action', 'userId', 'userEmail', 'timestamp', 'metadata'
          ])
          && isValidTimestamp(request.resource.data.timestamp);
        allow update, delete: if false;
      }

      // ─── integritySeals (SHA256 seal registry) ──────────────────────────
      match /integritySeals/{sealId} {
        allow read: if isOwner(userId) && isValidId(sealId);
        allow create: if isOwner(userId)
          && isValidId(sealId)
          && maxDocSize(2048)
          && request.resource.data.keys().hasOnly([
            'seal', 'moduleId', 'sealType', 'timestamp', 'dataHash', 'app'
          ])
          && isValidTimestamp(request.resource.data.timestamp);
        allow update, delete: if false;
      }

      // ─── passkeyCredentials ─────────────────────────────────────────────
      // Writes are performed exclusively by the Admin SDK (Cloud Functions).
      // Client-side: owner may read own credential list; no client-side writes.
      match /passkeyCredentials/{credentialId} {
        allow read: if isOwner(userId) && isValidId(credentialId);
        allow write: if false;
      }
    }

    // ─── GLOBAL COLLECTIONS (non-user-scoped) ───────────────────────────────

    // ─── chat_sessions (Architect AI conversation history) ─────────────────
    // FIX: This collection was missing a rule → default deny caused "Operation: get"
    // errors in ArchitectAI. Each session doc is keyed by the user's UID.
    match /chat_sessions/{sessionId} {
      allow read, write: if isSignedIn()
        && request.auth.uid == sessionId
        && isValidId(sessionId)
        && maxDocSize(131072); // 128 KB — sufficient for conversation history
    }

    // ─── identity_vectors (shared read-only reference data) ────────────────
    match /identity_vectors/{vectorId} {
      allow read: if isSignedIn() && isValidId(vectorId);
      allow write: if isAdmin();
    }

    // ─── user_vector_statuses (user-specific status, indexed by uid_vectorId) ─
    match /user_vector_statuses/{statusId} {
      allow read: if isSignedIn()
        && isValidId(statusId)
        && (request.auth.token.admin == true
          || (resource.data.userUid == request.auth.uid));
      allow create, update: if isSignedIn()
        && isValidId(statusId)
        && request.resource.data.userUid == request.auth.uid
        && maxDocSize(4096)
        && isValidTimestamp(request.resource.data.lastScanAt);
      allow delete: if false;
    }

    // ─── findings (scan findings — legacy top-level compatibility) ─────────
    match /findings/{findingId} {
      allow read: if isSignedIn()
        && isValidId(findingId)
        && (resource.data.userUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(findingId)
        && request.resource.data.userUid == request.auth.uid
        && maxDocSize(4096)
        && isValidTimestamp(request.resource.data.createdAt);
      allow update: if isSignedIn()
        && isValidId(findingId)
        && resource.data.userUid == request.auth.uid
        && maxDocSize(4096)
        && request.time - resource.data.createdAt < duration.value(24, 'h');
      allow delete: if false;
    }

    // ─── monitored_emails ──────────────────────────────────────────────────
    match /monitored_emails/{emailId} {
      allow read: if isSignedIn()
        && isValidId(emailId)
        && (resource.data.userUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && isValidId(emailId)
        && request.resource.data.userUid == request.auth.uid
        && maxDocSize(2048)
        && isValidTimestamp(request.resource.data.createdAt);
      allow update: if isSignedIn()
        && isValidId(emailId)
        && resource.data.userUid == request.auth.uid
        && maxDocSize(2048);
      allow delete: if isSignedIn()
        && isValidId(emailId)
        && resource.data.userUid == request.auth.uid;
    }

    // ─── audit_logs (global audit log — Cloud Functions only) ──────────────
    // Writes are exclusively server-side. Admin read for oversight.
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
